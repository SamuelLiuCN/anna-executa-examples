{
  "slug": "document-extractor",
  "name": "Document Extractor",
  "version": "0.1.8",
  "executa_type": "tool",
  "description": "Extracts plain text from documents, spreadsheets, and archives for the MLPS Review Anna App.",
  "tool_id": "tool-intern2-document-extractor-u2n2j8x5",
  "type": "python",
  "enabled": true,
  "distribution": {
    "active": "binary",
    "profiles": {
      "local": {
        "type": "local",
        "supports_protocol": true
      },
      "binary": {
        "type": "binary",
        "executable_name": "tool-intern2-document-extractor-u2n2j8x5",
        "supports_protocol": true,
        "capabilities": [
          "extract_document",
          "list_archive",
          "import_archive_chunk",
          "extract_archive_entry"
        ],
        "binary_artifacts": {
          "darwin-arm64": {
            "path": "bundle/tool-intern2-document-extractor-u2n2j8x5-v{version}-darwin-arm64.tar.gz",
            "entrypoint": "tool-intern2-document-extractor-u2n2j8x5",
            "format": "tar.gz"
          },
          "darwin-x86_64": {
            "path": "bundle/tool-intern2-document-extractor-u2n2j8x5-v{version}-darwin-x86_64.tar.gz",
            "entrypoint": "tool-intern2-document-extractor-u2n2j8x5",
            "format": "tar.gz"
          },
          "linux-x86_64": {
            "path": "bundle/tool-intern2-document-extractor-u2n2j8x5-v{version}-linux-x86_64.tar.gz",
            "entrypoint": "tool-intern2-document-extractor-u2n2j8x5",
            "format": "tar.gz"
          }
        }
      }
    }
  },
  "_comment": "Use active=binary for staging/production so apps cut directly uploads local binary_artifacts into Anna storage. The artifact paths are relative to this Executa directory, and {version} expands from this file. For local development, run anna-app apps push --profile local or anna-app dev from the app root."
}
