{
  "schema": 2,
  "permissions": [
    "tools.invoke",
    "llm.complete",
    "chat.write_message",
    "storage.read",
    "storage.write"
  ],
  "required_executas": [
    {
      "tool_id": "bundled:document-extractor",
      "min_version": "0.1.0",
      "version": "latest"
    }
  ],
  "optional_executas": [],
  "system_prompt_addendum": "The user has the MLPS Review app open. It extracts ordinary PDF/DOCX/PPTX/XLSX/XLS files through Anna native Agent Session doc_read/sheet_read tools when available, falls back to the bundled document-extractor Executa for archives and OCR, then calls anna.llm.complete to review the document against MLPS requirements. Treat results as a review aid, cite only evidence found in the uploaded document, and avoid claiming legal certification.",
  "tags": [
    "mlps",
    "compliance",
    "document-review",
    "security"
  ],
  "ui": {
    "bundle": {
      "format": "static-spa",
      "entry": "index.html",
      "external_origins": []
    },
    "views": [
      {
        "name": "main",
        "title": "MLPS Review",
        "default": true,
        "entry": "index.html",
        "min_size": {
          "w": 520,
          "h": 620
        },
        "default_size": {
          "w": 860,
          "h": 760
        },
        "max_size": {
          "w": 1440,
          "h": 1100
        },
        "resizable": true,
        "movable": true,
        "single_instance": true
      }
    ],
    "host_api": {
      "tools": [
        "required:bundled:document-extractor"
      ],
      "files": [
        "upload_init",
        "upload_finalize",
        "download_url",
        "download",
        "list",
        "delete"
      ],
      "storage": [
        "get",
        "set",
        "list",
        "delete"
      ],
      "llm": [
        "complete"
      ],
      "chat": [
        "write_message"
      ],
      "agent": {
        "session": {
          "auto": true
        },
        "tools": [
          "doc_read",
          "sheet_read"
        ]
      },
      "window": [
        "set_title"
      ]
    },
    "csp_overrides": {
      "script-src": [
        "'self'"
      ],
      "style-src": [
        "'self'"
      ],
      "connect-src": [
        "'self'",
        "https:",
        "http://localhost:*",
        "http://127.0.0.1:*"
      ]
    },
    "state_merge": "last_writer_wins"
  },
  "dev": {
    "fixtures": [
      "fixtures/*.jsonl"
    ],
    "user_id": 1
  }
}
